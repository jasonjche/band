ringUnit": {"state": "new","value": "± %1$lld · %2$@"}}}},"·": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "·"}}}},"· %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "· %@"}}}},"· GPS": {"localizations": {}},"· ~day %lld": {"localizations": {}},"· ~day %lld–%lld": {"localizations": {"en": {"stringUnit": {"state": "new","value": "· ~day %1$lld–%2$lld"}}}},"× %@ on save.": {"localizations": {}},"Δ": {"localizations": {}},"Δ vs prev": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Δ vs prev"}}}},"–": {"localizations": {}},"—": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "—"}}}},"“Dose” here is timing (later in the day = stronger), not milligrams.": {"localizations": {}},"•": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "•"}}}},"≈ %@ steps (auto)": {"localizations": {}},"≈ %@ steps at this setting": {"localizations": {}},"Language": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Language"}}}},"Language changes take effect after you reopen NOOP.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Language changes take effect after you reopen NOOP."}}}},"12-hour": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "12-hour"}}}},"24-hour": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "24-hour"}}}},"Clock": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Clock"}}}},"Archived": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Archived"}}}},"Current": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Current"}}}},"Scope": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Scope"}}}},"A workout must be at least 1 minute.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "A workout must be at least 1 minute."}}}},"AI Coach": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "AI Coach"}}}},"Hide bar when scrolling": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Hide bar when scrolling"}}}},"System default": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "System default"}}}},"✓": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "✓"}}}},"Reduce motion in NOOP": {"localizations": {}},"Holds the liquid gauges, the sky and the tilt response still, and turns off the motion sensor that drives them. Saves battery. Low Power Mode and the system Reduce Motion setting already do this.": {"localizations": {}},"No live heart rate or synced history yet this session.": {"localizations": {}},"Connected. No live heart rate or synced history yet this session.": {"localizations": {}},"Your strap recorded little movement overnight (common on WHOOP 4.0), so this night may be under-detected and the sleep total can read short. Make sure the strap fully synced; the numbers are kept as-is.": {"localizations": {}},"May be incomplete": {"localizations": {}},"Only %lld%% of this night's window has stage data. The stage totals cover only that part of the night.": {"localizations": {}},"Partly recorded": {"localizations": {}},"Customize": {"localizations": {}},"Customize Sleep": {"localizations": {}},"Shown": {"localizations": {}},"%@ workout": {"localizations": {}},"Double tap to %@": {"localizations": {}},"Double tap to start": {"localizations": {}},"Elapsed time": {"localizations": {}},"No workouts found": {"localizations": {}},"Recording workout": {"localizations": {}},"Stops recording and saves what's captured so far": {"localizations": {}},"Try a different activity name.": {"localizations": {}},"PER STRAP": {"localizations": {}},"NOOP Limitations": {"localizations": {}},"What each WHOOP can read": {"localizations": {}},"WHAT NOOP READS": {"localizations": {}},"Feature": {"localizations": {}},"5.0/MG": {"localizations": {}},"LEGEND": {"localizations": {}},"What each strap can read live, and what needs an import.": {"localizations": {}},"ECG raw-data gate (WHOOP MG only)": {"localizations": {}},"Turn gate on (write '1')": {"localizations": {}},"Turn gate off (write '0')": {"localizations": {}},"Your strap listed its own device-config keys, and one of them is enable_raw_data_w_ecg. On an MG with no ECG subscription it reads '0' — while all three ECG commands answer SUCCESS and send no data at all (#891). This is the leading guess for what's holding ECG shut. Nobody knows whether flipping it actually produces ECG data: finding out is the point, and \"still nothing\" is a useful answer worth posting to #891.": {"localizations": {}},"This writes a setting that STAYS ON YOUR STRAP until you change it back — it isn't an app preference, and closing NOOP won't undo it. \"Turn gate off\" below writes '0' again, in one tap. Only this one key is ever written; the other six your strap listed are never touched.": {"localizations": {}},"Accent": {"localizations": {}},"Accent colour": {"localizations": {}},"Custom accent colour": {"localizations": {}},"Preset": {"localizations": {}},"Theme preset": {"localizations": {}},"This never leaves your device unless you export a backup yourself.": {"localizations": {}},"Cycle tracker": {"localizations": {}},"Delete all logged period starts?": {"localizations": {}},"Delete all period history": {"localizations": {}},"This permanently removes the on-device period-start history. Sensor history is not changed.": {"localizations": {}},"Current estimate": {"localizations": {}},"~day %lld": {"localizations": {}},"~day %lld-%lld": {"localizations": {}},"Likely period window: %@-%@. This is a range, not a fixed date.": {"localizations": {}},"Log a period start": {"localizations": {}},"Already logged": {"localizations": {}},"This optional date anchors cycle day 1 and is checked against your nightly temperature pattern.": {"localizations": {}},"Logged starts": {"localizations": {}},"Delete all": {"localizations": {}},"No period starts logged yet.": {"localizations": {}},"Menstrual Cycle": {"localizations": {}},"Private, on-device tracking": {"localizations": {}},"Log period starts locally and use them to anchor optional cycle estimates.": {"localizations": {}},"Latest period start": {"localizations": {}},"Open tracker": {"localizations": {}},"Set up cycle tracking": {"localizations": {}},"Log today": {"localizations": {}},"Preparing cycle tracker…": {"localizations": {}},"Period-start history": {"localizations": {}},"Period started on": {"localizations": {}},"No nightly skin-temp yet — needs ~4 worn nights (or import a WHOOP CSV)": {"localizations": {}},"Skin Temp Δ": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Skin Temp Δ"}}}},"vs baseline": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "vs baseline"}}}},"Replace from Photos": {"localizations": {}},"Choose from Photos": {"localizations": {}},"Browse files": {"localizations": {}},"Show custom background": {"localizations": {}},"Scaling": {"localizations": {}},"Background scaling": {"localizations": {}},"Remove image": {"localizations": {}},"Optional. Use your own photo behind every tab, in place of the day-cycle sky. It stays on %@ and is never uploaded. Pair it with Transparent cards above to let it show through.": {"localizations": {}},"Transparent cards": {"localizations": {}},"Let the background show through every card. Tune how much just below.": {"localizations": {}},"Export route": {"localizations": {}},"GPX — Strava, Garmin, most apps": {"localizations": {}},"FIT — Garmin Connect": {"localizations": {}},"Save this route as a standard file you can import into Strava, Garmin Connect, and other apps.": {"localizations": {}},"Active calories": {"localizations": {}},"Active-calorie heatmap, last 13 weeks": {"localizations": {}},"Less": {"localizations": {}},"Share recap": {"localizations": {}},"Sleep chart": {"localizations": {}},"Custom HR zones": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Custom HR zones"}}}},"Set the BPM where each zone begins. Turn off to restore the default percentage-of-max zones.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Set the BPM where each zone begins. Turn off to restore the default percentage-of-max zones."}}}},"Zone %lld starts": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Zone %lld starts"}}}},"Zone %lld starts at %lld beats per minute": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Zone %lld starts at %lld beats per minute"}}}},"Add your waist for a more accurate VO₂max": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Add your waist for a more accurate VO₂max"}}}},"Scanning the catalog…": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Scanning the catalog…"}}}},"This device can't support a rhythm reading": {"localizations": {}},"Rhythm needs beat-to-beat timing measured one beat at a time. Your device stores its heartbeats in batches, so the exact spacing between them isn't recoverable. Nothing is wrong with your night.": {"localizations": {}},"Rhythm reads only during still, resting windows, and this device doesn't record the stillness signal it needs to find them. Nothing is wrong with your night.": {"localizations": {}},"Show cycle awareness": {"localizations": {}},"Shows the cycle-awareness card on Today and in Health. Turn off to hide it entirely — a private choice, never based on your age. You can turn it back on here any time.": {"localizations": {}},"Soma": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Soma"}}}},"Hold…": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Hold…"}}}},"Tummo": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Tummo"}}}},"10 min": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "10 min"}}}},"15 min": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "15 min"}}}},"Guided": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Guided"}}}},"Ujjayi": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Ujjayi"}}}},"Buteyko": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Buteyko"}}}},"Wim Hof": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Wim Hof"}}}},"Belly in": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Belly in"}}}},"Force out": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Force out"}}}},"Hold full": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Hold full"}}}},"Bhastrika": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Bhastrika"}}}},"Belly out": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Belly out"}}}},"Hold empty": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Hold empty"}}}},"Holotropic": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Holotropic"}}}},"Box 4-4-4-4": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Box 4-4-4-4"}}}},"Inhale left": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Inhale left"}}}},"Kapalabhati": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Kapalabhati"}}}},"Exhale left": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Exhale left"}}}},"Inhale right": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Inhale right"}}}},"Presence Mid": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Presence Mid"}}}},"Coherent 6-6": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Coherent 6-6"}}}},"Guided timer": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Guided timer"}}}},"Exhale right": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Exhale right"}}}},"Protocol info": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Protocol info"}}}},"Diaphragmatic": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Diaphragmatic"}}}},"Qi Gong Breath": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Qi Gong Breath"}}}},"Deep Breathing": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Deep Breathing"}}}},"Session length": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Session length"}}}},"Shamanic Breath": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Shamanic Breath"}}}},"About this pace": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "About this pace"}}}},"Follow the cue…": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Follow the cue…"}}}},"Buteyko Reduced": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Buteyko Reduced"}}}},"Presence Regular": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Presence Regular"}}}},"Presence Punching": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Presence Punching"}}}},"Alternate Nostril": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Alternate Nostril"}}}},"The Presence Process": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "The Presence Process"}}}},"Forceful 1s in · 1s out": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Forceful 1s in · 1s out"}}}},"Guided · rhythmic rapid": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Guided · rhythmic rapid"}}}},"Guided · rounds + holds": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Guided · rounds + holds"}}}},"2s in · 2s out · rhythmic": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "2s in · 2s out · rhythmic"}}}},"Belly breath · soft pause": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Belly breath · soft pause"}}}},"Lighter · longer soft hold": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Lighter · longer soft hold"}}}},"6s in · 6s out · ~5 br/min": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "6s in · 6s out · ~5 br/min"}}}},"Ocean breath · soft throat": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Ocean breath · soft throat"}}}},"Guided · rapid belly pulses": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Guided · rapid belly pulses"}}}},"Inhale 4 · hold 7 · exhale 8": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Inhale 4 · hold 7 · exhale 8"}}}},"Guided · continuous connected": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Guided · continuous connected"}}}},"Gentle nasal · light air hunger": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Gentle nasal · light air hunger"}}}},"Slow in · soft holds · slow out": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Slow in · soft holds · slow out"}}}},"Nadi Shodhana · left/right cycle": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Nadi Shodhana · left/right cycle"}}}},"CCB · ~3.8s / 3.8s · ~7.8 br/min": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "CCB · ~3.8s / 3.8s · ~7.8 br/min"}}}},"CCB · ~2.4s / 2.4s · ~12.4 br/min": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "CCB · ~2.4s / 2.4s · ~12.4 br/min"}}}},"CCB · ~1.9s / 1.9s · push-through": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "CCB · ~1.9s / 1.9s · push-through"}}}},"Forced exhale · holds · slow in/out": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Forced exhale · holds · slow in/out"}}}},"Slow inhale · soft hold · long exhale": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Slow inhale · soft hold · long exhale"}}}},"A few minutes is enough; build gradually.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "A few minutes is enough; build gradually."}}}},"Never push into panic or strong air hunger.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Never push into panic or strong air hunger."}}}},"Often 20+ minutes; pick a length that fits.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Often 20+ minutes; pick a length that fits."}}}},"Prefer guided settings for intense practice.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Prefer guided settings for intense practice."}}}},"15–30 minutes is traditional; start shorter.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "15–30 minutes is traditional; start shorter."}}}},"About 5 minutes per session; repeat as needed.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "About 5 minutes per session; repeat as needed."}}}},"5–10 minutes daily is a common starting point.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "5–10 minutes daily is a common starting point."}}}},"15 minutes, twice daily (Presence Process frame).": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "15 minutes, twice daily (Presence Process frame)."}}}},"15 minutes once you are using Mid as your starter.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "15 minutes once you are using Mid as your starter."}}}},"Your locked resonance pace from the Resonance sweep.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Your locked resonance pace from the Resonance sweep."}}}},"Stay in a comfortable range; never force breath holds.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stay in a comfortable range; never force breath holds."}}}},"Estimate only — not medical advice. Stop if you feel unwell.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Estimate only — not medical advice. Stop if you feel unwell."}}}},"If you feel dizzy or uncomfortable, stop and breathe normally.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "If you feel dizzy or uncomfortable, stop and breathe normally."}}}},"Traditional sessions are long; use a short timer here as a check-in only.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Traditional sessions are long; use a short timer here as a check-in only."}}}},"Never practice in water or while driving. Stop if dizzy. Not medical advice.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Never practice in water or while driving. Stop if dizzy. Not medical advice."}}}},"Skip if pregnant, dizzy, or have uncontrolled hypertension. Stop if strained.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Skip if pregnant, dizzy, or have uncontrolled hypertension. Stop if strained."}}}},"Not recommended as a beginner default unless the goal is to overcome drowsiness.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Not recommended as a beginner default unless the goal is to overcome drowsiness."}}}},"Advanced. Avoid if pregnant, cardiovascular issues, or unwell. Not medical advice.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Advanced. Avoid if pregnant, cardiovascular issues, or unwell. Not medical advice."}}}},"Stop if dizzy. Avoid with high blood pressure, pregnancy, or recent surgery unless cleared by a clinician.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stop if dizzy. Avoid with high blood pressure, pregnancy, or recent surgery unless cleared by a clinician."}}}},"\n\nRegular tempo (~3.8s in / 3.8s out) is the default sustainable pace for a first pass and for staying the full 15 minutes.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\n\nRegular tempo (~3.8s in / 3.8s out) is the default sustainable pace for a first pass and for staying the full 15 minutes."}}}},"Gentle Qi Gong-style pacing: inhale ~4.5s, optional short hold, exhale ~4.5s, optional short hold. Soft belly focus; no force.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Gentle Qi Gong-style pacing: inhale ~4.5s, optional short hold, exhale ~4.5s, optional short hold. Soft belly focus; no force."}}}},"Bhastrika (bellows): forceful 1-second nasal inhale and exhale. Energising and intense. Keep rounds short and rest between them.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Bhastrika (bellows): forceful 1-second nasal inhale and exhale. Energising and intense. Keep rounds short and rest between them."}}}},"Not for DIY high-intensity sessions if you have trauma history, cardiovascular issues, or pregnancy without professional guidance.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Not for DIY high-intensity sessions if you have trauma history, cardiovascular issues, or pregnancy without professional guidance."}}}},"Simple rhythmic connected pacing at 2 seconds in and 2 seconds out — useful when you want a steady musical-feel loop without holds.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Simple rhythmic connected pacing at 2 seconds in and 2 seconds out — useful when you want a steady musical-feel loop without holds."}}}},"Reduced Buteyko-style: ~2s gentle inhale, ~3s exhale, then a 3–5s hold with mild air hunger only. Stay relaxed in the face and shoulders.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Reduced Buteyko-style: ~2s gentle inhale, ~3s exhale, then a 3–5s hold with mild air hunger only. Stay relaxed in the face and shoulders."}}}},"Ujjayi (ocean) breath: slightly constrict the throat so the breath sounds like distant waves. Equal slow inhale and exhale through the nose (~4.5s each).": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Ujjayi (ocean) breath: slightly constrict the throat so the breath sounds like distant waves. Equal slow inhale and exhale through the nose (~4.5s each)."}}}},"Shamanic-style rhythmic breathing is context-dependent and often facilitated. Use this as a quiet timer with education only — set your own safe intensity.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Shamanic-style rhythmic breathing is context-dependent and often facilitated. Use this as a quiet timer with education only — set your own safe intensity."}}}},"\n\nMid session tempo (~2.4s / 2.4s) is a starting pace for later passes through the procedure; once settled you may slow deeper or switch to Punching Through.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\n\nMid session tempo (~2.4s / 2.4s) is a starting pace for later passes through the procedure; once settled you may slow deeper or switch to Punching Through."}}}},"Classic 4-7-8: quiet nasal inhale for 4, hold for 7, long mouth exhale for 8. Often used to wind down. Start with a few cycles; stop if you feel light-headed.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Classic 4-7-8: quiet nasal inhale for 4, hold for 7, long mouth exhale for 8. Often used to wind down. Start with a few cycles; stop if you feel light-headed."}}}},"Buteyko-style reduced breathing: small nasal inhale (~2.5s), relaxed nasal exhale (~3.5s), short comfortable hold (~3.5s). Keep it quiet and light — not a big gasp.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Buteyko-style reduced breathing: small nasal inhale (~2.5s), relaxed nasal exhale (~3.5s), short comfortable hold (~3.5s). Keep it quiet and light — not a big gasp."}}}},"A simple calming pace: inhale for 4 seconds, exhale for 6. The longer exhale tends to favour a rest-and-digest feel. Use it when you want an easy downshift without holds.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "A simple calming pace: inhale for 4 seconds, exhale for 6. The longer exhale tends to favour a rest-and-digest feel. Use it when you want an easy downshift without holds."}}}},"\n\nPunching Through (~1.9s / 1.9s) is for sleepiness or feeling stuck — not the beginner default. After you are “in it”, you may return to a slower, deeper connected breath.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\n\nPunching Through (~1.9s / 1.9s) is for sleepiness or feeling stuck — not the beginner default. After you are “in it”, you may return to a slower, deeper connected breath."}}}},"Deep breathing with a short pause: inhale 4s, hold 2s, exhale 6s. Breathe through the nose when you can, fill the lungs without forcing, and let the longer exhale slow you down.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Deep breathing with a short pause: inhale 4s, hold 2s, exhale 6s. Breathe through the nose when you can, fill the lungs without forcing, and let the longer exhale slow you down."}}}},"Coherent breathing at six seconds in and six seconds out (~5 breaths per minute). A slow equal pace aimed at calm and HRV-friendly rhythm — estimate only, not a clinical reading.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Coherent breathing at six seconds in and six seconds out (~5 breaths per minute). A slow equal pace aimed at calm and HRV-friendly rhythm — estimate only, not a clinical reading."}}}},"Equal inhale and exhale at about 5.5 breaths per minute — a common coherence / resonance starting point. Steady, balanced pacing for settling heart-rate variability during a session.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Equal inhale and exhale at about 5.5 breaths per minute — a common coherence / resonance starting point. Steady, balanced pacing for settling heart-rate variability during a session."}}}},"Box (square) breathing: inhale, hold, exhale, hold — each for 4 seconds. A structured rhythm often used for focus and settling under stress. Sit comfortably and keep the counts even.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Box (square) breathing: inhale, hold, exhale, hold — each for 4 seconds. A structured rhythm often used for focus and settling under stress. Sit comfortably and keep the counts even."}}}},"A paced Tummo-inspired cycle using mid-range timings: short forced exhale, empty hold, slow inhale, full hold, slow exhale. Advanced and intense — keep sessions short and stop if strained.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "A paced Tummo-inspired cycle using mid-range timings: short forced exhale, empty hold, slow inhale, full hold, slow exhale. Advanced and intense — keep sessions short and stop if strained."}}}},"Kapalabhati uses rapid, active belly exhales with passive inhales. Timing varies by person — this mode gives you a timer and coaching text only, not a forced metronome. Practice seated, short rounds, rest between.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Kapalabhati uses rapid, active belly exhales with passive inhales. Timing varies by person — this mode gives you a timer and coaching text only, not a forced metronome. Practice seated, short rounds, rest between."}}}},"Diaphragmatic (belly) breathing: expand the abdomen on the inhale more than the chest, optional short hold, then gently contract on the exhale. Same 4–2–6 timing as deep breathing, with attention on the diaphragm.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Diaphragmatic (belly) breathing: expand the abdomen on the inhale more than the chest, optional short hold, then gently contract on the exhale. Same 4–2–6 timing as deep breathing, with attention on the diaphragm."}}}},"Alternate-nostril breathing: inhale left, hold, exhale right, inhale right, hold, exhale left — about 4 seconds each step. Use a finger to gently close one nostril at a time. Labels cue which side; go at a calm pace.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Alternate-nostril breathing: inhale left, hold, exhale right, inhale right, hold, exhale left — about 4 seconds each step. Use a finger to gently close one nostril at a time. Labels cue which side; go at a calm pace."}}}},"Holotropic-style work is continuous, often rapid connected breathing in a supported setting. NOOP only offers a session timer and education — not an auto-pacer — because intensity varies widely and is normally facilitated.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Holotropic-style work is continuous, often rapid connected breathing in a supported setting. NOOP only offers a session timer and education — not an auto-pacer — because intensity varies widely and is normally facilitated."}}}},"Wim Hof–style rounds typically use ~30 deeper breaths, then an empty hold, then a recovery inhale hold (~15s). Because holds and intensity are personal, this entry is guided: follow a trusted protocol you already know; NOOP times the session and shows reminders — it does not force breath holds.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Wim Hof–style rounds typically use ~30 deeper breaths, then an empty hold, then a recovery inhale hold (~15s). Because holds and intensity are personal, this entry is guided: follow a trusted protocol you already know; NOOP times the session and shows reminders — it does not force breath holds."}}}},"Consciously Connected Breathing (CCB): inhale and exhale in one continuous loop with no hold at the top or bottom. Find a comfortable rhythm — connectedness matters more than intensity. Typical practice is about 15 minutes, twice daily. Regular is the sustainable starter tempo; Mid is a quicker start for later rounds; Punching Through is only when you need to push through drowsiness or stuckness (not a beginner default).": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Consciously Connected Breathing (CCB): inhale and exhale in one continuous loop with no hold at the top or bottom. Find a comfortable rhythm — connectedness matters more than intensity. Typical practice is about 15 minutes, twice daily. Regular is the sustainable starter tempo; Mid is a quicker start for later rounds; Punching Through is only when you need to push through drowsiness or stuckness (not a beginner default)."}}}},"\nConsciously Connected Breathing (CCB): inhale and exhale in one continuous loop with no hold at the top or bottom. Find a comfortable rhythm — connectedness matters more than intensity. Typical practice is about 15 minutes, twice daily. Regular is the sustainable starter tempo; Mid is a quicker start for later rounds; Punching Through is only when you need to push through drowsiness or stuckness (not a beginner default).\n": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\nConsciously Connected Breathing (CCB): inhale and exhale in one continuous loop with no hold at the top or bottom. Find a comfortable rhythm — connectedness matters more than intensity. Typical practice is about 15 minutes, twice daily. Regular is the sustainable starter tempo; Mid is a quicker start for later rounds; Punching Through is only when you need to push through drowsiness or stuckness (not a beginner default).\n"}}}},"Regular tempo (~3.8s in / 3.8s out) is the default sustainable pace for a first pass and for staying the full 15 minutes.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\n\nRegular tempo (~3.8s in / 3.8s out) is the default sustainable pace for a first pass and for staying the full 15 minutes."}}}},"Mid session tempo (~2.4s / 2.4s) is a starting pace for later passes through the procedure; once settled you may slow deeper or switch to Punching Through.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\n\nMid session tempo (~2.4s / 2.4s) is a starting pace for later passes through the procedure; once settled you may slow deeper or switch to Punching Through."}}}},"Punching Through (~1.9s / 1.9s) is for sleepiness or feeling stuck — not the beginner default. After you are “in it”, you may return to a slower, deeper connected breath.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "\n\nPunching Through (~1.9s / 1.9s) is for sleepiness or feeling stuck — not the beginner default. After you are “in it”, you may return to a slower, deeper connected breath."}}}},"A training read, separate from your Charge score.": {"localizations": {}},"Training Load": {"localizations": {}},"CTL · Fitness": {"localizations": {}},"ATL · Fatigue": {"localizations": {}},"42-day fitness vs 7-day fatigue": {"localizations": {}},"Building — %lld of %lld days": {"localizations": {}},"Chronic vs acute load": {"localizations": {}},"Needs %lld+ consecutive days of Effort to begin. %lld so far.": {"localizations": {}},"Form": {"localizations": {}},"Training load: chronic vs acute": {"localizations": {}},"Low refresh": {"localizations": {}},"Sync in the background every hour instead of every 15 minutes, whatever the strap's charge — fewer reconnections is the biggest saving on a WHOOP 4.0. Nothing is lost: the strap banks everything and hands it over in larger batches. Pull to sync still runs straight away, and live heart rate is untouched.": {"localizations": {}},"Power saving": {"localizations": {}},"Ease the load on your strap when its battery is running low.": {"localizations": {}},"The strap keeps banking data on its own, so nothing is lost — NOOP just talks to it less often to help it last until you can charge it.": {"localizations": {}},"Synced %@": {"localizations": {}},"Synced %@ ago": {"localizations": {}},"Effort: exponential intensity scale": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Effort: exponential intensity scale"}}}},"Scores Effort on an exponential intensity curve (Banister TRIMP) instead of the default heart-rate zones (Edwards). The default earns nothing below half of your heart-rate reserve, so an hour of lifting — where hard sets average out against the rests — can score close to zero. The exponential curve has no floor and weights short, hard efforts far more heavily. Re-scores your history, and both scales reach the same maximum. Off by default.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Scores Effort on an exponential intensity curve (Banister TRIMP) instead of the default heart-rate zones (Edwards). The default earns nothing below half of your heart-rate reserve, so an hour of lifting — where hard sets average out against the rests — can score close to zero. The exponential curve has no floor and weights short, hard efforts far more heavily. Re-scores your history, and both scales reach the same maximum. Off by default."}}}},"A cardiovascular load from time in heart-rate zones (Edwards TRIMP): each zone is weighted so harder ones count for more, summed into one daily figure. Settings offers an exponential alternative (Banister) that credits short, hard efforts more.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "A cardiovascular load from time in heart-rate zones (Edwards TRIMP): each zone is weighted so harder ones count for more, summed into one daily figure. Settings offers an exponential alternative (Banister) that credits short, hard efforts more."}}}},"WHOOP 5.0 / MG supports live data and strap history. Protocol-research tools are available separately in Test Centre.": {"shouldTranslate": false,"localizations": {}},"Delete this session?": {"shouldTranslate": false,"localizations": {}},"The session %@ and its captured raw data will be deleted permanently.": {"shouldTranslate": false,"localizations": {}},"Delete all sessions?": {"shouldTranslate": false,"localizations": {}},"All %lld recorded sessions and their captured raw data will be deleted permanently.": {"shouldTranslate": false,"localizations": {}},"Couldn't export session": {"shouldTranslate": false,"localizations": {}},"Unknown error": {"shouldTranslate": false,"localizations": {}},"Capture coverage": {"shouldTranslate": false,"localizations": {}},"Band: connected%@": {"shouldTranslate": false,"localizations": {}},"Band: disconnected": {"shouldTranslate": false,"localizations": {}},"History sync: running (%lld chunks)": {"shouldTranslate": false,"localizations": {}},"History sync: idle": {"shouldTranslate": false,"localizations": {}},"Realtime IMU: session active since %@": {"shouldTranslate": false,"localizations": {}},"Historical export window": {"shouldTranslate": false,"localizations": {}},"Create a session from synchronized history without starting a live capture. 100 Hz coverage is included wherever it still exists in the rolling buffer.": {"shouldTranslate": false,"localizations": {}},"Recorded sessions": {"shouldTranslate": false,"localizations": {}},"No sessions recorded yet.": {"shouldTranslate": false,"localizations": {}},"Export status: recording": {"shouldTranslate": false,"localizations": {}},"IMU: %@": {"shouldTranslate": false,"localizations": {}},"Last exported %@ · export remains available": {"localizations": {}},"Export status: %lld raw batches": {"shouldTranslate": false,"localizations": {}},"Legacy R22 feature-flag experiment. The strap accepts these writes, but NOOP has not observed them enabling a separate live stream. This is not required for normal WHOOP 5/MG support or for the Raw Data Collector. It writes persistent strap settings and may do nothing on your firmware.": {"shouldTranslate": false,"localizations": {}},"NOOP estimates your steps from your WHOOP's stored motion, calibrated to your phone's step count. It's an estimate, not a hardware step counter; normal WHOOP 5/MG history sync supplies the motion data.": {"shouldTranslate": false,"localizations": {}},"5/MG RAW DATA COLLECTOR": {"shouldTranslate": false,"localizations": {}},"Record, review, export, and delete bounded 100 Hz motion sessions. Normal sync is unchanged.": {"shouldTranslate": false,"localizations": {}},"Open raw-data collector": {"shouldTranslate": false,"localizations": {}},"WHOOP 5/MG connected.": {"shouldTranslate": false,"localizations": {}},"Connect your WHOOP 5/MG to start a capture.": {"shouldTranslate": false,"localizations": {}},"5/MG PROTOCOL DIAGNOSTICS": {"shouldTranslate": false,"localizations": {}},"Developer tools for unmapped protocol features. None of these are required for normal WHOOP 5/MG recording, history sync, or the bounded Raw Data Collector.": {"shouldTranslate": false,"localizations": {}},"Protocol probes": {"shouldTranslate": false,"localizations": {}},"Sends experimental protocol queries and records replies in the strap log. Also enables the experimental 5/MG strap alarm.": {"shouldTranslate": true,"localizations": {}},"Broadcast heart rate from the strap": {"shouldTranslate": false,"localizations": {}},"Writes the reversible 5/MG advertising flag for Garmin, Zwift, and compatible gym equipment.": {"shouldTranslate": false,"localizations": {}},"Legacy R22 feature-flag experiment": {"shouldTranslate": false,"localizations": {}},"The strap accepts these writes, but NOOP has not observed them enabling a separate live stream. This is not the Raw Data Collector.": {"shouldTranslate": false,"localizations": {}},"WHOOP MG ECG raw-data gate": {"shouldTranslate": false,"localizations": {}},"MG-only protocol instrumentation, not a medical ECG feature.": {"shouldTranslate": false,"localizations": {}},"Passive history/protocol trace": {"shouldTranslate": false,"localizations": {}},"Records frames that already arrive. It does not start sensors and can create large files. Use the export section below to save the trace with its strap log.": {"shouldTranslate": false,"localizations": {}},"Couldn't delete session": {"shouldTranslate": false,"localizations": {}},"5/MG Raw Data Collector": {"shouldTranslate": false,"localizations": {}},"Record a bounded 100 Hz motion session and export its complete timeline.": {"shouldTranslate": false,"localizations": {}},"Start raw-data session": {"shouldTranslate": false,"localizations": {}},"Add historical session": {"shouldTranslate": false,"localizations": {}},"Delete all sessions": {"shouldTranslate": false,"localizations": {}},"Session comment": {"shouldTranslate": false,"localizations": {}},"Building export…": {"shouldTranslate": false,"localizations": {}},"Export session": {"shouldTranslate": false,"localizations": {}},"Delete session": {"shouldTranslate": false,"localizations": {}},"The export file could not be created or shared.": {"shouldTranslate": false,"localizations": {}},"To": {"shouldTranslate": false,"localizations": {}},"0": {"shouldTranslate": false,"localizations": {}},"Connect your WHOOP 5/MG to start a raw-data session.": {"shouldTranslate": false,"localizations": {}},"Add marker": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Add marker"}}}},"Edit marker": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Edit marker"}}}},"Delete marker": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Delete marker"}}}},"Marker type": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Marker type"}}}},"Marker note": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Marker note"}}}},"Current time: %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Current time: %@"}}}},"Marker: %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Marker: %@"}}}},"Moment": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Moment"}}}},"Issue": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Issue"}}}},"−10 s": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "−10 s"}}}},"+10 s": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "+10 s"}}}}," · %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": " · %@"}}}},"Check what the strap has stored": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Check what the strap has stored"}}}},"The answer from the strap appears in your strap log and debug export, with the raw bytes it replied with.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "The answer from the strap appears in your strap log and debug export, with the raw bytes it replied with."}}}},"Last night against your clock": {"localizations": {}},"In sync with your body clock": {"localizations": {}},"%@ later than your body clock": {"localizations": {}},"%@ earlier than your body clock": {"localizations": {}},"Morning type": {"localizations": {}},"Intermediate type": {"localizations": {}},"Evening type": {"localizations": {}},"Body clock dial": {"localizations": {}},"Your clock": {"localizations": {}},"iCloud Drive": {"localizations": {}},"iCloud Drive › %@": {"localizations": {}},"NOOP (in Files)": {"localizations": {}},"Live heart rate is streaming, but your strap is not fully paired. The encrypted pairing is what carries motion, skin temperature, SpO₂ and respiratory rate — without it, sleep is staged from heart rate alone. Buzz, alarms and history sync need it too.": {"localizations": {}},"Clear conversation": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Clear conversation"}}}},"Clear the saved conversation": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Clear the saved conversation"}}}},"Clear conversation?": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Clear conversation?"}}}},"This deletes the saved conversation from this device. Coach history is your own notes, not medical advice.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "This deletes the saved conversation from this device. Coach history is your own notes, not medical advice."}}}},"Morning brief": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Morning brief"}}}},"A local notification with today's readiness + training plan, generated on-device each morning.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "A local notification with today's readiness + training plan, generated on-device each morning."}}}},"Off: nothing is generated or sent on a schedule.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Off: nothing is generated or sent on a schedule."}}}},"Morning brief time": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Morning brief time"}}}},"At %@, NOOP will use your key to generate today's brief. Best-effort: %@ decides exactly when a backgrounded app wakes.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "At %@, NOOP will use your key to generate today's brief. Best-effort: %@ decides exactly when a backgrounded app wakes."}}}},"Send chart image to Gemini": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Send chart image to Gemini"}}}},"On: a chart snapshot of your trends is sent with each question. Gemini can analyze the visual.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "On: a chart snapshot of your trends is sent with each question. Gemini can analyze the visual."}}}},"Off: only text is sent. Enable to let Gemini see your charts.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Off: only text is sent. Enable to let Gemini see your charts."}}}},"Save to Journal": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Save to Journal"}}}},"Follow-up prompt: %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Follow-up prompt: %@"}}}},"~%lld tokens": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "~%lld tokens"}}}},"· may exceed small context windows": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "· may exceed small context windows"}}}},"Ask out loud": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Ask out loud"}}}},"Stop voice input": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stop voice input"}}}},"Voice input": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Voice input"}}}},"Coach Brief": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Coach Brief"}}}},"No brief yet": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "No brief yet"}}}},"Enable Morning Brief in Coach settings to see today's readiness here.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Enable Morning Brief in Coach settings to see today's readiness here."}}}},"Voice input unavailable. Check microphone permission in Settings.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Voice input unavailable. Check microphone permission in Settings."}}}},"On-device speech not available for %@.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "On-device speech not available for %@."}}}},"Couldn't start the microphone: %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Couldn't start the microphone: %@"}}}},"%lld of %lld nights": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "%lld of %lld nights"}}}},"%lld of the last %lld nights recorded no HRV. Check the strap is worn overnight and syncing.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "%lld of the last %lld nights recorded no HRV. Check the strap is worn overnight and syncing."}}}},"Re-derives the absolute °C for nights the 21-night rescore window never reaches, using the same funnel as the scoring pass. Fill-only: it never overwrites a measured value. Watch the strap log for the result.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Re-derives the absolute °C for nights the 21-night rescore window never reaches, using the same funnel as the scoring pass. Fill-only: it never overwrites a measured value. Watch the strap log for the result."}}}},"Opens the trend and readings": {"localizations": {}},"CVA PPG sampler": {"localizations": {}},"Disable": {"localizations": {}},"DOB (raw)": {"localizations": {}},"Earlier beats cannot be scored": {"localizations": {}},"Enable": {"localizations": {}},"Enables or disables SpO2 or real-steps directly via SetFeatureMode, then re-reads the feature's status. Unvalidated on NOOP's own hardware (OURA_PROTOCOL.md §7.5) — a third-party report is what these buttons exist to test.": {"localizations": {}},"Enables or disables SpO2, real-steps, exercise HR, or the CVA PPG sampler directly via SetFeatureMode, then re-reads the feature's status. Unvalidated on NOOP's own hardware (OURA_PROTOCOL.md §7.5) — a third-party report is what these buttons exist to test. Daytime HR and resting HR are deliberately not offered here: daytime HR has its own dedicated live-HR path, and resting HR has no app-level toggle at all.": {"localizations": {}},"Exercise HR": {"localizations": {}},"Field": {"localizations": {}},"Frame: %@": {"localizations": {}},"Mode": {"localizations": {}},"OURA": {"localizations": {}},"Oura feature enable (experimental)": {"localizations": {}},"Oura user-info write (experimental)": {"localizations": {}},"Real steps": {"localizations": {}},"Sends %@ to the ring. This changes ring-side config. Restore with the firmware default (height 176, weight 75, sex 2) or write zeros.": {"localizations": {}},"Sends %@ to the ring. Unvalidated on NOOP's own hardware (OURA_PROTOCOL.md §7.5). Mode 0x00 always reverts. Watch the strap log for the follow-up feature-status read.": {"localizations": {}},"Sends %@ to the ring. Unvalidated on NOOP's own hardware (OURA_PROTOCOL.md §7.5). Watch the strap log for the follow-up feature-status read.": {"localizations": {}},"Sends a SetFeatureMode write for SpO2 or real-steps, then re-reads the feature's status. Unvalidated on NOOP's own hardware (OURA_PROTOCOL.md §7.5) — a third-party report is what this button exists to test. Mode “off” always reverts.": {"localizations": {}},"This night was recorded before NOOP labelled which WHOOP 5 transport each heartbeat came from, so its intervals mix two different units with nothing stored to tell them apart. The night stays in your history, and nights recorded from now on score normally.": {"localizations": {}},"Paste the corrected key. Your conversation is kept.": {"localizations": {}},"Corrected API key": {"localizations": {}},"Open your Charge detail": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Open your Charge detail"}}}},"Open your Effort detail": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Open your Effort detail"}}}},"Open your Rest detail": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Open your Rest detail"}}}},"Open your Stress detail": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Open your Stress detail"}}}},"Write": {"localizations": {}},"Write to ring": {"localizations": {}},"Write to the ring?": {"localizations": {}},"Write zeros": {"localizations": {}},"Writes one 0x20 user-info field to the ring and logs what comes back. The ring reports 0x5c as firmware defaults (40 y, 75 kg, sex unset, 176 cm) even though your Oura app profile is correct, and the Oura app never writes it. Whether 0x20 lands in 0x5c is UNKNOWN, and so is the value encoding: try 175 for cm, then 1750 for mm. Age has no setter, only date-of-birth, whose 9-byte layout is unknown, so it is raw hex only. Tested only on Gen 3 so far — Gen 5 validation is open.": {"localizations": {}},"On: your charge, rest, HRV and workouts are sent to the provider, each workout with its sport, duration, distance and heart rate.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "On: your charge, rest, HRV and workouts are sent to the provider, each workout with its sport, duration, distance and heart rate."}}}},"Strap alarm wake time": {"localizations": {}},"Your usual wake time": {"localizations": {}},"This time does not wake you. It only decides when the evening reminder fires.": {"localizations": {}},"Your strap alarm is what wakes you, next on %@.": {"localizations": {}},"Set a wake time for specific days (a lie-in at the weekend, say). These times move your strap alarm AND the evening reminder on those days.": {"localizations": {}},"Days you leave alone use the usual wake time above.": {"localizations": {}},"Days you leave alone keep your strap alarm at %@, and time the reminder from %@.": {"localizations": {}},"Some days have a time of their own, set under the evening reminder below. Next buzz %@.": {"localizations": {}},"Alarm in %@": {"localizations": {}},"Alarm in less than a minute": {"localizations": {}},"Usual wake": {"localizations": {}},"A calm nudge %lldh %lldm before your usual wake time.": {"localizations": {}},"Turn on the wind-down reminder below to land at your usual wake time rested.": {"localizations": {}},"no time of its own": {"localizations": {}},"Update key": {"localizations": {}},"%lld hours excluded — you were moving.": {"localizations": {}},"1 hour excluded — you were moving.": {"localizations": {}},"Autonomic load across your waking day": {"localizations": {}},"The line is each waking hour's 0-3 proxy, scored against your personal daytime baseline (how your own days usually run). The bar below splits your day into calm, moderate and high stress time.": {"localizations": {}},"End session": {"localizations": {}},"Use NOOP's own folder (browse in Files)": {"localizations": {}},"Generate now": {"localizations": {}},"Generating…": {"localizations": {}},"YOUR BANDS": {"localizations": {}},"REMOVED": {"localizations": {}},"one strap": {"localizations": {}},"Number": {"localizations": {}},"Yes/No": {"localizations": {}},"HRV (rMSSD)": {"localizations": {}},"Recovery & strain": {"localizations": {}},"Stress (on-device)": {"localizations": {}},"Workout detection": {"localizations": {}},"Blood oxygen (SpO₂ %)": {"localizations": {}},"ECG": {"localizations": {}},"Beat-to-beat variation": {"localizations": {}},"Extra or skipped beats": {"localizations": {}},"Custom colour": {"localizations": {}},"Date of birth": {"localizations": {}},"Day cycle": {"localizations": {}},"Raw on-device stages": {"localizations": {}},"Oura": {"shouldTranslate": false,"localizations": {}}},"version": "1.0"}
