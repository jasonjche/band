y %2$@."}}}},"Stop session": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stop session"}}}},"Stop sweep": {"localizations": {}},"Stop sync": {"localizations": {}},"Stops reading a cycle phase from your nightly temperature. You can turn it back on here any time.": {"localizations": {}},"Stops the screen dimming while a workout is recording": {"localizations": {}},"Storage": {"localizations": {}},"Storage unavailable": {"localizations": {}},"Stored as %@. %@": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Stored as %1$@. %2$@"}}}},"Strain": {"localizations": {}},"Strain nudges and your smart alarm tap your wrist the moment they fire.": {"localizations": {}},"Strain nudges and your smart alarm tap your wrist the same way.": {"localizations": {}},"Strain target": {"localizations": {}},"Strained": {"localizations": {}},"Strap": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Strap"}}}},"Strap accepted %lld/15 R22 flags…": {"localizations": {}},"Strap accepted all 15 R22 flags": {"localizations": {}},"Strap battery": {"localizations": {}},"Strap battery %lld percent%@%@": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Strap battery %1$lld percent%2$@%3$@"}}}},"Strap battery low": {"localizations": {}},"Strap bonded": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Strap bonded"}}}},"Strap connected": {"localizations": {}},"Strap data into Apple Health without HealthKit, for sideloaded installs.": {"localizations": {}},"Strap fully charged": {"localizations": {}},"Strap history": {"localizations": {}},"Strap history synced %@ ago": {"localizations": {}},"Strap idle": {"localizations": {}},"Strap live": {"localizations": {}},"Strap log exported": {"localizations": {}},"Strap name": {"localizations": {}},"Strap needed": {"localizations": {}},"Strap not connected": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Strap not connected"}}}},"Strap not connected. Tap to connect.": {"localizations": {}},"Strap not worn": {"localizations": {}},"Strap sync": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Strap sync"}}}},"Strap wake-alarm": {"localizations": {}},"Streak": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Streak"}}}},"Streaming live": {"localizations": {}},"Streaming now": {"localizations": {}},"Strength Activity Time": {"localizations": {}},"Stress": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress"}}}},"Stress through the day": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress through the day"}}}},"Stress %@ of 3": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress %@ of 3"}}}},"Stress %@ of 3, %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress %@ of 3, %@"}}}},"Stress Trend": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress Trend"}}}},"Stress avg": {"localizations": {}},"Stress check-in": {"localizations": {}},"Stress check-ins (haptic)": {"localizations": {}},"Stress is derived from two autonomic signals.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress is derived from two autonomic signals."}}}},"Stress monitor": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress monitor"}}}},"Stress trend": {"localizations": {}},"Stress · %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress · %@"}}}},"Stress · M": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Stress · M"}}}},"Strong": {"localizations": {}},"Suggested prompt: %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Suggested prompt: %@"}}}},"Summary": {"localizations": {}},"Sun": {"localizations": {}},"Sunday": {"localizations": {}},"Supplements": {"localizations": {}},"Support": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Support"}}}},"Support NOOP": {"localizations": {}},"Support NOOP, donate or get in touch": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Support NOOP, donate or get in touch"}}}},"Support NOOP. It's free; donations are optional and help development.": {"localizations": {}},"Support NOOP: donate or get in touch": {"localizations": {}},"Support the build": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Support the build"}}}},"Suppress auto-nudges overnight (10pm–7am).": {"localizations": {}},"Sustained high stress": {"localizations": {}},"Sweep progress": {"localizations": {}},"Sweeping…": {"localizations": {}},"Sympathetic vs parasympathetic tone from frequency-domain HRV. Higher leans sympathetic (stress-ward).": {"localizations": {}},"Sync": {"localizations": {}},"Sync now": {"localizations": {}},"Synced from": {"localizations": {}},"Synced from: %@": {"localizations": {}},"Syncing": {"localizations": {}},"Syncing strap history": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Syncing strap history"}}}},"Syncing strap history, %lld chunks": {"localizations": {"en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated","value": "Syncing strap history, %lld chunk"}},"other": {"stringUnit": {"state": "translated","value": "Syncing strap history, %lld chunks"}}}}}}},"%lld pages behind at connect": {"extractionState": "manual","localizations": {"en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated","value": "%lld page behind at connect"}},"other": {"stringUnit": {"state": "translated","value": "%lld pages behind at connect"}}}}}}},"Syncing strap history, %lld chunks, %@": {"extractionState": "manual","localizations": {"en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated","value": "Syncing strap history, %lld chunk, %@"}},"other": {"stringUnit": {"state": "translated","value": "Syncing strap history, %lld chunks, %@"}}}}}}},"Pending sync": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Pending sync"}}}},"strap history still offloading": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "strap history still offloading"}}}},"Syncing strap history…": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Syncing strap history…"}}}},"Syncing…": {"localizations": {}},"Syncs your strap's stored history right away, instead of waiting for the next automatic sync.": {"localizations": {}},"Synthesis": {"localizations": {}},"Synthesis. %@": {"localizations": {}},"System follows your %@'s light or dark setting.": {"localizations": {}},"Systolic": {"localizations": {}},"Systolic blood pressure in mmHg": {"localizations": {}},"TEST MODES": {"localizations": {}},"THE BASICS": {"localizations": {}},"THE ONE RULE": {"localizations": {}},"THE THREE SCORES": {"localizations": {}},"TIME": {"localizations": {}},"TYPICAL EFFORT": {"localizations": {}},"Tag a few sessions of the same activity and NOOP will learn its personal recovery cost.": {"localizations": {}},"Take a 60-second seated HRV reading from the live R-R stream.": {"localizations": {}},"Take an HRV reading": {"localizations": {}},"Take another reading": {"localizations": {}},"Take it over locally. Beta.": {"localizations": {}},"Take over": {"localizations": {}},"Take over this ring": {"localizations": {}},"Take over this ring?": {"localizations": {}},"Take over your ring locally. Beta. This replaces the Oura app.": {"localizations": {}},"Takes effect on the next analytics pass (after the next sync).": {"localizations": {}},"Taking over your ring": {"localizations": {}},"Tap a day to catch up": {"localizations": {}},"Tap a drink to edit it, or use the trash to delete.": {"localizations": {}},"Tap a stage to compare with your 30-day typical.": {"localizations": {}},"Tap a workout for its detail · tap ••• to re-label, edit or delete it.": {"localizations": {}},"Tap the one that's yours.": {"localizations": {}},"Tap to compare": {"localizations": {}},"Tap to edit the amount": {"localizations": {}},"Tap to log": {"localizations": {}},"Tap when you're heading to bed or when you wake. Each tap is logged with the time. It doesn't change tonight's detected sleep.": {"localizations": {}},"Temperature": {"localizations": {}},"Skin temperature display": {"localizations": {}},"Temperature unit": {"localizations": {}},"Test %@ buzz": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Test %@ buzz"}}}},"Test Centre": {"localizations": {}},"Test action": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Test action"}}}},"Test buzz": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Test buzz"}}}},"Testing %@ br/min…": {"localizations": {}},"That file is too large to import.": {"localizations": {}},"That file isn't a NOOP backup. It doesn't look like a SQLite database.": {"localizations": {}},"That is not a 32-character hex key.": {"localizations": {}},"That's normal. A paced breath often settles things when a metronome alone doesn't.": {"localizations": {}},"That's why a watch-only Charge starts out “Calibrating”. NOOP needs about seven nights of your HRV to learn what normal looks like for you. Until it has them it withholds the score rather than guess. Once the baseline is set, your Charge appears with its confidence, on the same 0-100 scale as a strap's.": {"localizations": {}},"That's why a watch-only Charge starts out “Calibrating”. NOOP needs about seven nights of your HRV to learn what normal looks like for you. Until it has them it withholds the score rather than guess. Once the baseline is set, your Charge appears with its confidence, on the same 0–100 scale as a strap's.": {"localizations": {}},"The Oura app and your Oura account stop working with this ring. This is the point. You are replacing Oura.": {"localizations": {}},"The WHOOP 4.0 reboot frame isn't confirmed — a normal Restart is ignored (#235). Send each candidate and watch BOTH the strap log and the strap itself. “no disconnect within 12s” means the strap ignored the frame. A “link dropped” line means the frame reached the strap — but a dropped link alone isn't a reboot: a real reboot also switches the strap's sensor light off for a few seconds, so if the light stayed on it was just a dropped connection, not a reboot. Non-destructive — your data is kept. Please share the log so we can pin the real frame.": {"localizations": {}},"The WHOOP MG has ECG electrodes in its clasp. This unlocks a gated, hand-run probe on the Devices screen that asks the strap to start its ECG subsystem and logs whatever comes back. MG only — a plain WHOOP 5.0 has no electrodes, and NOOP will refuse to send unless your strap identifies itself as an MG. Nobody has confirmed a strap honours these commands, so it may simply do nothing. Turn on “Record puffin frames to a file” below first if you want a complete byte-level capture to share.": {"localizations": {}},"The average above was edited. The graph, zones and Effort stay from the recorded session.": {"localizations": {}},"The backup archive doesn't contain a database file.": {"localizations": {}},"The best-sourced number per metric across every band you use.": {"localizations": {}},"The change from your heart rate at the end of exercise. Positive values mean your heart rate fell; a dash means the strap did not record enough data around that minute.": {"localizations": {}},"The full terms are in TERMS.md, shipped with NOOP. This is not legal advice.": {"localizations": {}},"The honest catch: a watch isn't a chest strap. It's brilliant at sleep, steps, workouts and fitness, and lighter on the dense heart-rate-variability a strap measures all night. So recovery takes about a week to calibrate, and a couple of metrics depend on your watch model. NOOP is upfront about all of it. Every watch-derived number carries a confidence, and where the watch can't be honest, NOOP shows nothing instead of a made-up figure.": {"localizations": {}},"The line is each waking hour's 0-3 proxy, scored against your own calm hours today. The bar below splits your day into calm, moderate and high stress time.": {"localizations": {}},"The line is each waking hour's 0–3 proxy, scored against your own calm hours today. The bar below splits your day into calm, moderate and high stress time.": {"localizations": {}},"The master switch for every wrist buzz (inactivity, stress, alerts). Off keeps the strap quiet no matter what else is on.": {"localizations": {}},"The method behind the score, not today's values.": {"localizations": {}},"The nudge fires %lldh %lldm before this.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "The nudge fires %1$lldh %2$lldm before this."}}}},"The numbers": {"localizations": {}},"The scatter looked rounder and more spread out than a tight, steady beat. This has many ordinary causes and is not a diagnosis.": {"localizations": {}},"The strap alarm is a silent buzz, not a sound": {"localizations": {}},"The strap buzzes a gentle rhythm just below your current heart rate, a felt metronome to relax toward. It trails your heart down rather than yanking it, and stops on its own.": {"localizations": {}},"The strap keeps reporting a different time than NOOP sends, so its firmware alarm won't fire at your wake time — usually a strap whose clock or alarm has reset. Reset the strap in the official WHOOP app (or fully charge it and reconnect), and keep your phone's Clock alarm as your wake until it takes.": {"localizations": {}},"The thread of you over time.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "The thread of you over time."}}}},"The wake-alarm above buzzes your wrist from the strap's own firmware. It can't sound a loud alarm, and a sideloaded app can't sound a reliable background wake on this device either (that needs a critical-alert permission this build doesn't have). Keep your phone's built-in Clock alarm as a backup. NOOP's phone-based smart wake (light-sleep detection) is available on the Android app.": {"extractionState": "stale","localizations": {}},"The wake-alarm above buzzes your wrist from the strap's own firmware. It can't sound a loud alarm. We also schedule a backup notification at your wake time, but a sideloaded app can't sound a guaranteed wake on this device (that needs a critical-alert permission this build doesn't have), so Focus or silent mode can still mute it. Keep your phone's built-in Clock alarm as your real backup. NOOP's phone-based smart wake (light-sleep detection) is available on the Android app.": {"localizations": {}},"Theme": {"localizations": {}},"There are no NOOP backups in your folder yet. Use Back up now first.": {"localizations": {}},"There wasn't a calm, still window clean enough to describe. Try again after a settled night.": {"localizations": {}},"There's about %@ of leftover import scratch space to reclaim. This never removes your imported data.": {"localizations": {}},"There's no NOOP data to export yet.": {"localizations": {}},"There's no NOOP data to export yet. Import or record some first.": {"localizations": {}},"These are experimental probes, off by default. The fuller WHOOP 5/MG controls and the raw-sensor CSV export still live in Settings under Diagnostics.": {"localizations": {}},"These are extra, on-demand HRV lenses computed from today's R-R intervals. They are informational and do not change the stress score above.": {"localizations": {}},"These are independent approximations from a consumer strap, built on open science: not medical advice, and not WHOOP's official scores.": {"localizations": {}},"These are independent estimates computed on your device from your Apple Health data, not medical advice. Confidence labels are honest about how much NOOP knows so far.": {"localizations": {}},"These are the days where your phone also counted steps, so NOOP can learn how your motion maps to steps. Or set the coefficient manually below.": {"localizations": {}},"These are your own numbers shown back to you. NOOP doesn't decide whether any value is normal, high or low.": {"localizations": {}},"These backups are unencrypted too. If this folder syncs to Drive, Dropbox or iCloud, the readable file goes there as well — only point it at a service you trust.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "These backups are unencrypted too. If this folder syncs to Drive, Dropbox or iCloud, the readable file goes there as well — only point it at a service you trust."}}}},"These days are excluded from the estimate (your phone's real count is shown instead). They're here only so you can judge the estimate's accuracy.": {"localizations": {}},"These power your heart-rate zones, calorie estimates and recovery baselines. Keep them accurate.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "These power your heart-rate zones, calorie estimates and recovery baselines. Keep them accurate."}}}},"These vitals are from %@": {"localizations": {}},"Thinking": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Thinking"}}}},"This builds from the strap as it syncs. Effort and rest appear after you have worn it and slept a night. Charge needs about four nights of sleep to learn your baseline (you'll see \"Calibrating\" until then), and keeps sharpening over your first couple of weeks. On a WHOOP 5 or MG the strap banks little history, so the night count can climb slowly or sit at 0 of 4 until you have worn it across a few nights. That's its sync limit, not a fault. Import your WHOOP export to skip the wait.": {"localizations": {}},"This builds from the strap as it syncs. Strain and sleep appear after you have worn it and slept a night. Recovery needs about a week of nights to learn your baseline, or import your WHOOP export to skip the wait.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "This builds from the strap as it syncs. Strain and sleep appear after you have worn it and slept a night. Recovery needs about a week of nights to learn your baseline, or import your WHOOP export to skip the wait."}}}},"This deletes every scheduled strap-log and raw-capture file NOOP has saved. This can't be undone.": {"localizations": {}},"This install can't connect to Apple Health directly. It was sideloaded with a free signing profile, which doesn't include Apple's Health permission, so there's nothing to enable, and NOOP won't appear under Settings › Health.": {"extractionState": "stale","localizations": {}},"This install can't connect to Apple Health directly. It was sideloaded with a free signing profile, which doesn't include Apple's Health permission, so there's nothing to grant here.": {"extractionState": "stale","localizations": {}},"This install can't connect to Apple Health directly. It was signed with a profile that doesn't include Apple's Health permission, so there's nothing to enable, and NOOP won't appear under Settings › Health.": {"localizations": {}},"This install can't connect to Apple Health directly. It was signed with a profile that doesn't include Apple's Health permission, so there's nothing to grant here.": {"localizations": {}},"This is a plain, unencrypted archive — anyone who gets the file can open it with any zip tool. Store it somewhere you trust.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "This is a plain, unencrypted archive — anyone who gets the file can open it with any zip tool. Store it somewhere you trust."}}}},"This is a sideloaded build, installed outside the App Store. It needs re-signing periodically: roughly every 7 days on a free Apple ID, about a year on a paid developer account.": {"localizations": {}},"This is a wellness visualization, not a screening test. It does not tell you to see a clinician and it names no condition. This is not legal or medical advice.": {"localizations": {}},"This is an experimental wellness visualization of your beat-to-beat timing. It is NOT an ECG, and it cannot diagnose, detect, or rule out any heart condition.": {"localizations": {}},"This is exactly what your report will contain. Nothing leaves %@ until you tap Share.": {"localizations": {}},"This is the only feature that leaves %@. It sends a summary of your metrics to %@ using your own key. Nothing is sent until you ask.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "This is the only feature that leaves %1$@, it sends a summary of your metrics to %2$@ using your own key. Nothing is sent until you ask."}}}},"This is the only feature that leaves your Mac, it sends a summary of your metrics to %@ using your own key. Nothing is sent until you ask.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "This is the only feature that leaves your Mac, it sends a summary of your metrics to %@ using your own key. Nothing is sent until you ask."}}}},"This is your last scored session. Wear the strap overnight for a fresh score.": {"localizations": {}},"This is your only sleep block today.": {"localizations": {}},"This isn't a NOOP backup from this app. It's missing the migration bookkeeping a NOOP backup carries (it looks like an Android backup or another app's database), and restoring it would strand your store. To move your history across platforms, export the WHOOP-format CSV on the other device (Settings → Export data) and import that here, or import your original WHOOP / Apple Health export.": {"localizations": {}},"This moves the night to a time with no recorded data. Stages can't be derived there, so it may show as empty until data covers it.": {"localizations": {}},"This night scored high efficiency but very little deep or REM, more likely a staging estimate miss than a real restorative shortfall. The totals are kept as-is; read the split with care.": {"localizations": {}},"This one is different from the other ECG controls: it is a setting written to the strap, and it stays there after you disconnect until you change it again.": {"localizations": {}},"This permanently deletes all data recorded from %@. This can't be undone.": {"localizations": {}},"This permanently deletes everything imported from Apple Health: heart rate, HRV, sleep, steps, workouts and more. Your live strap data is untouched. This can't be undone.": {"localizations": {}},"This restarts the roughly 4-night build-up for Charge and your HRV baseline. Your history stays.": {"localizations": {}},"This restarts the roughly 4-night build-up for Charge and your HRV baseline. Your history stays. Use it if a bad first week, like wearing it while sick, set your baseline off.": {"localizations": {}},"This session": {"localizations": {}},"This session's contribution to the day's Effort, as captured during the workout.": {"localizations": {}},"This sideloaded build expired %lld days ago. Re-sign it to keep it running.": {"localizations": {}},"This sideloaded build expired 1 day ago. Re-sign it to keep it running.": {"localizations": {}},"This sideloaded build expires in %lld days. Re-sign to keep it running.": {"localizations": {}},"This sideloaded build expires in 1 day. Re-sign to keep it running.": {"localizations": {}},"This split is the ring's raw on-device classification read over Bluetooth, not the adjusted stages the Oura app shows. Expect more Awake and less Deep/REM here than in the Oura app for the same night.": {"localizations": {}},"This stands on community reverse-engineering. Huge thanks:": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "This stands on community reverse-engineering. Huge thanks:"}}}},"This stays on your device. It is never uploaded, never synced, never shared.": {"localizations": {}},"This stops recording and saves what's captured so far. It can't be resumed.": {"localizations": {}},"This week": {"localizations": {}},"Three quiet promises.": {"localizations": {}},"Threshold": {"localizations": {}},"Thu": {"localizations": {}},"Thursday": {"localizations": {}},"Time": {"localizations": {}},"Time asleep": {"localizations": {}},"Time in Bed": {"localizations": {}},"Time in each %HRmax zone, derived from the strap's heart rate over this window (approximate).": {"localizations": {}},"Time of day": {"localizations": {}},"Time range": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Time range"}}}},"Time to move. You've been seated a while.": {"localizations": {}},"Time to wind down": {"localizations": {}},"Timing forecast": {"localizations": {}},"Tip: choose a folder in iCloud Drive and your backups sync to all your Apple devices automatically, no account setup needed.": {"localizations": {}},"Tip: the share sheet can save the PDF to Files, AirDrop it, or send it on.": {"localizations": {}},"To get your Apple Health data in anyway: import a Health export .zip in Data Sources, or turn on Shortcuts Export to feed your strap data into Health without the entitlement. (A build installed from the App Store or signed with a paid Apple Developer account connects directly.)": {"localizations": {}},"Today": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Today"}}}},"Today's Timeline": {"localizations": {}},"Today's drinks": {"localizations": {}},"Today's fluid": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Today's fluid"}}}},"Today's mood": {"localizations": {}},"Today's mood: %@, %lld of 5": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Today's mood: %1$@, %2$lld of 5"}}}},"Today's scores owned by %@": {"localizations": {}},"Today's stress split: calm %@, moderate %@, high %@.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Today's stress split: calm %1$@, moderate %2$@, high %3$@."}}}},"Today's value is your recorded daily stress score (0–3).": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Today's value is your recorded daily stress score (0–3)."}}}},"Today, %@": {"localizations": {}},"Today’s Synthesis": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Today’s Synthesis"}}}},"Tomorrow": {"localizations": {}},"Tomorrow's Charge": {"localizations": {}},"Tomorrow's Charge estimate %lld plus or minus %lld": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Tomorrow's Charge estimate %1$lld plus or minus %2$lld"}}}},"Tomorrow’s %@": {"localizations": {}},"Tonight": {"localizations": {}},"Tonight's lands after you sleep with the strap on.": {"localizations": {}},"Tonight’s forecast": {"localizations": {}},"Too short to judge — the band needs a few minutes to mean anything.": {"localizations": {}},"Top sport": {"localizations": {}},"Total": {"localizations": {}},"Total Calories": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Total Calories"}}}},"Total Distance": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Total Distance"}}}},"Total Time": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Total Time"}}}},"Total Workouts": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Total Workouts"}}}},"Track a workout manually. Records heart rate and effort until you end it.": {"localizations": {}},"Trailing": {"localizations": {}},"Trailing %lld days": {"localizations": {}},"Trailing window": {"localizations": {}},"Train by feel. The strap buzzes so you don't have to watch a screen.": {"localizations": {}},"Training load": {"localizations": {}},"Training variety": {"localizations": {}},"Treadmill, indoor bike, rower or cross-trainer (Bluetooth FTMS)": {"localizations": {}},"Trend": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Trend"}}}},"Trend charts": {"localizations": {}},"Trend only where supported, and Apple removed the SpO₂ sensor from the newest US units, so on those it simply isn't there. NOOP shows nothing rather than a fake reading.": {"localizations": {}},"Trend window": {"localizations": {}},"Trends": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Trends"}}}},"Trends need history to draw. Import your WHOOP export in Data Sources to see weeks, months and years instantly.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Trends need history to draw. Import your WHOOP export in Data Sources to see weeks, months and years instantly."}}}},"Trends report": {"localizations": {}},"Triple": {"localizations": {}},"Try WHOOP 5/MG protocol probes": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Try WHOOP 5/MG protocol probes"}}}},"Try again": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Try again"}}}},"Tue": {"localizations": {}},"Tuesday": {"localizations": {}},"Turn off": {"localizations": {}},"Turn off cycle awareness": {"localizations": {}},"Turn on Rhythm": {"localizations": {}},"Turn on a test for the thing that's wrong, wear the strap, then tap Report. All on %@.": {"localizations": {}},"Turn on a test for the thing that's wrong, wear the strap, then tap Report. Your strap log, recalibrate, scheduled export and experimental probes all live here too.": {"localizations": {}},"Turn on cycle awareness": {"localizations": {}},"Turn on notifications for NOOP in Settings to get your wind-down reminder.": {"localizations": {}},"Two independent protocol tables disagree on the extended-battery opcode (98 vs 87). This sends the curated read-only 98 and shows the strap's full raw reply. A battery-style payload confirms 98 on your firmware; a short stub means it stays ambiguous. Nothing is written to the strap.": {"localizations": {}},"Type in a blood-pressure reading or a cholesterol value from your last appointment. It stays on %@, and over time you'll see how it lines up with your sleep, heart rate and recovery.": {"localizations": {}},"Type in a number from your own report. It stays on %@.": {"localizations": {}},"Typical for you": {"localizations": {}},"Typical range": {"localizations": {}},"Undo": {"localizations": {}},"Unit": {"localizations": {}},"Units": {"localizations": {}},"Unknown": {"localizations": {}},"Unlock WHOOP 5/MG deep data (R22)": {"localizations": {}},"Sharpens your VO₂max": {"localizations": {}},"Unread. %@. %@": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Unread. %1$@. %2$@"}}}},"Unvalidated instrumentation, not a medical measurement and not a diagnosis.": {"comment": "MEDICAL SAFETY COPY — needs a native speaker, not a machine translation. Deliberately left untranslated: a disclaimer that drifts in meaning is worse than one shown in English. Until a human translates it, the absent localizations make the runtime fall back to this English source text, which is correct and complete. Keep every element when translating: not a medical device, not a diagnosis, and the instruction to see a doctor.","shouldTranslate": false,"localizations": {}},"Updated weekly": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Updated weekly"}}}},"Updates": {"localizations": {}},"Updates, %lld unread": {"localizations": {}},"Use": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Use"}}}},"Use NOOP with just an Apple Watch. What it's great at, and where it's lighter than a strap.": {"localizations": {}},"Use NOOP with your watch": {"localizations": {}},"Use custom model": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Use custom model"}}}},"Use file import": {"localizations": {}},"Use file import for Oura": {"localizations": {}},"Use it only with a device you own, to read your own data. Whether to use it (and any effect on your WHOOP account, subscription, device, or warranty) is your decision, and your risk alone.": {"extractionState": "manual","localizations": {}},"Use my resonance pace": {"localizations": {}},"Uses the watch's Broadcast Heart Rate. We'll show you how.": {"localizations": {}},"Using": {"localizations": {}},"Using NOOP may breach WHOOP's Terms of Service": {"extractionState": "manual","localizations": {}},"Using NOOP on iPhone": {"localizations": {}},"VO₂ Max": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "VO₂ Max"}}}},"VO₂ Max (estimated)": {"localizations": {}},"VO₂max": {"localizations": {}},"Value": {"localizations": {}},"Variation is normal and often benign": {"localizations": {}},"Version %@ is available": {"localizations": {}},"Very strong": {"localizations": {}},"Vibrate your connected WHOOP strap.": {"localizations": {}},"View active workout": {"localizations": {}},"View detail": {"localizations": {}},"View sources": {"localizations": {}},"View the active workout": {"localizations": {}},"View the full plan": {"localizations": {}},"Visual only": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Visual only"}}}},"Vital Signs": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Vital Signs"}}}},"Vitality": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Vitality"}}}},"W": {"localizations": {}},"WHAT IT'S GREAT AT": {"localizations": {}},"WHAT MOVES YOU ›": {"localizations": {}},"WHAT THE WATCH CAN DO": {"localizations": {}},"WHAT TO EXPECT": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "WHAT TO EXPECT"}}}},"WHAT'S NEW": {"localizations": {}},"WHERE IT'S LIGHTER THAN A STRAP": {"localizations": {}},"WHOOP 4.0 is tested and works end to end. WHOOP 5.0/MG is newer: live heart rate works today, but deeper metrics (recovery, strain, sleep) for 5/MG are still being figured out. NOOP always tells you what's live versus still building.": {"localizations": {}},"WHOOP 4.0 is the supported path": {"localizations": {}},"WHOOP 4.0 protocol": {"localizations": {}},"WHOOP 4.0 reboot probe": {"localizations": {}},"WHOOP 4.0 · motion → steps": {"localizations": {}},"WHOOP 5 / MG": {"localizations": {}},"WHOOP 5.0 / MG bonds to one device at a time. Unpair it from the official WHOOP app first.": {"localizations": {}},"WHOOP 5.0 / MG support is newer and still experimental in NOOP.": {"localizations": {}},"WHOOP 5.0 protocol": {"localizations": {}},"WHOOP 5.0/MG pairs with one app at a time. If a scan finds nothing, unpair it in the official WHOOP app and fully close that app, then Scan again.": {"localizations": {}},"WHOOP 5.0/MG pairs with one app at a time. If nothing's found, unpair it in the official WHOOP app and fully close that app, then Scan.": {"localizations": {}},"WHOOP 5/MG straps hand a fresh app only live heart rate. The official app switches on the deeper streams (high-rate HR + motion + history) by writing a set of feature flags, a sequence two independent projects have documented. With this on, the button below sends that exact sequence to your strap. Unlike everything else here it does write to the strap, but it's reversible (it only changes which data the strap chooses to emit) and is the same thing the official app does. Experimental: it may do nothing on your firmware. iPhone/Android only. A Mac can't write to a 5/MG.": {"localizations": {}},"WHOOP Export": {"localizations": {}},"WHOOP MG ECG capture (experimental)": {"localizations": {}},"WHOOP Strap (Live BLE)": {"localizations": {}},"WHOOP import": {"localizations": {}},"WHOOP is NOOP's primary, fully-supported band. Other heart-rate straps are an early, in-development addition: they stream live heart rate and HRV, but not WHOOP's deeper sleep and recovery data.": {"localizations": {}},"WHOOP is NOOP's primary, fully-supported band. Other heart-rate straps stream live heart rate and HRV, but not WHOOP's deeper sleep and recovery data.": {"localizations": {}},"WHOOP straps don't appear in macOS System Settings → Bluetooth. They advertise on a custom profile that only apps like NOOP can find, so there's nothing to pair there, and you shouldn't try.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "WHOOP straps don't appear in macOS System Settings → Bluetooth. They advertise on a custom profile that only apps like NOOP can find, so there's nothing to pair there, and you shouldn't try."}}}},"WHOOP straps don't appear in your %@'s Bluetooth settings. They advertise on a custom profile that only apps like NOOP can find, so there's nothing to pair there, and you shouldn't try.": {"localizations": {}},"WHOOP's imported per-zone split for this session.": {"localizations": {}},"WORK": {"localizations": {}},"WORKOUT IN PROGRESS": {"localizations": {}},"Waist (optional)": {"localizations": {}},"Waist in centimetres": {"localizations": {}},"Waist in inches": {"localizations": {}},"Waist not set": {"localizations": {}},"Waist, %lld centimetres": {"localizations": {}},"Waist, %lld inches": {"localizations": {}},"Waiting for R-R": {"localizations": {}},"Waiting for R-R intervals.": {"localizations": {}},"Waiting for a live heartbeat…": {"localizations": {}},"Waiting for a resting heart rate. Start a live reading first, or come back when you're still.": {"localizations": {}},"Waiting for the strap": {"localizations": {}},"Waiting for the strap's reply…": {"localizations": {}},"Wake": {"localizations": {}},"Wake at": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Wake at"}}}},"Wake me with a strap buzz": {"localizations": {}},"Wake the machine. Start pedalling, walking or rowing so it powers on its Bluetooth.": {"localizations": {}},"Wake time": {"localizations": {}},"Wake your Amazfit / Zepp band and make sure it isn't connected to the Zepp app right now.": {"localizations": {}},"Wake your Mi Band and make sure it isn't connected to the Mi Fitness / Zepp Life app right now.": {"localizations": {}},"Wake your strap. Put it on, or dampen the contacts.": {"localizations": {}},"Walking": {"localizations": {}},"Want the full breakdown of every metric and how sure NOOP is about each one? The “About Apple Watch data” page in Settings has the honest table.": {"localizations": {}},"Warmer than your baseline": {"localizations": {}},"Warming up. Cues stay quiet for the first minute.": {"localizations": {}},"Warming up. Keep moving to climb into Zone 1.": {"localizations": {}},"Warn me about caffeine close to bedtime": {"localizations": {}},"Warn me when I log caffeine too close to bedtime. A timing guide from your own bedtime, not a measurement.": {"localizations": {}},"Watch": {"localizations": {}},"Watch for early-illness signs": {"localizations": {}},"Watch your heart, live": {"localizations": {}},"Watches your resting HR, HRV, skin temperature and respiration against your own 28-day baseline. On-device and approximate: informational only, not a diagnosis.": {"localizations": {}},"We compare today's resting heart rate and HRV to your own 30-day baseline. A higher-than-usual resting HR and a lower-than-usual HRV both push the score up, classic signs the body is activated. The combined shift is mapped onto a 0-3 scale: 0 is calm, 1.5 sits at your baseline, 3 is highly activated.": {"localizations": {}},"We compare today's resting heart rate and HRV to your own 30-day baseline. A higher-than-usual resting HR and a lower-than-usual HRV both push the score up, classic signs the body is activated. The combined shift is mapped onto a 0–3 scale: 0 is calm, 1.5 sits at your baseline, 3 is highly activated.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "We compare today's resting heart rate and HRV to your own 30-day baseline. A higher-than-usual resting HR and a lower-than-usual HRV both push the score up, classic signs the body is activated. The combined shift is mapped onto a 0–3 scale: 0 is calm, 1.5 sits at your baseline, 3 is highly activated."}}}},"We could not take over this ring.": {"localizations": {}},"We're not seeing any motion from your strap yet. Steps are estimated from your WHOOP's banked motion history, so your strap needs to sync that history before NOOP has anything to count.": {"localizations": {}},"Wear & presence": {"localizations": {}},"Wear it snug on your wrist or bicep, sensor against skin.": {"localizations": {}},"Wear state": {"localizations": {}},"Wear the strap for scoring": {"localizations": {}},"Wear the strap overnight and these read from your nightly skin temperature.": {"localizations": {}},"Wear the strap overnight to score a night first.": {"localizations": {}},"Wear the strap, tap once, then let it sync and share your strap log.": {"localizations": {}},"Wed": {"localizations": {}},"Wednesday": {"localizations": {}},"Week in review": {"localizations": {}},"Weekdays": {"localizations": {}},"Weekends": {"localizations": {}},"Weekly": {"localizations": {}},"Weight": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Weight"}}}},"Weight in kilograms": {"localizations": {}},"Weight in pounds": {"localizations": {}},"Weight, %lld pounds": {"localizations": {}},"Wellbeing": {"localizations": {}},"Wellness score": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Wellness score"}}}},"What \"recording\" means": {"localizations": {}},"What Lab Book is (and isn't)": {"localizations": {}},"What Moves You": {"localizations": {}},"What NOOP does": {"localizations": {}},"What are you adding?": {"localizations": {}},"What changed": {"localizations": {}},"What correlates": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "What correlates"}}}},"What each activity costs your recovery": {"localizations": {}},"What moves you. Ranked patterns in your own data, and your dose-response.": {"localizations": {}},"What moves your %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "What moves your %@"}}}},"What shaped it": {"localizations": {}},"What shaped your Charge": {"localizations": {}},"What should today's training look like?": {"localizations": {}},"What to expect": {"localizations": {}},"What tracks your mood (%lld check-ins)": {"localizations": {}},"What you get": {"localizations": {}},"What you lose": {"localizations": {}},"What your watch is great at, where it's lighter than a chest strap, and how sure NOOP is.": {"localizations": {}},"What's new": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "What's new"}}}},"What's new in NOOP %@": {"localizations": {}},"What's new in the app and your data": {"localizations": {}},"When %@ is higher, %@ tends to be higher.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "When %1$@ is higher, %2$@ tends to be higher."}}}},"When %@ is higher, %@ tends to be lower.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "When %1$@ is higher, %2$@ tends to be lower."}}}},"When I double-tap": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "When I double-tap"}}}},"When NOOP reconstructs heart rate from the WHOOP 5/MG v26 optical waveform (the seconds the strap stored no HR), refine the autocorrelation peak with a parabolic sub-lag fit so the estimate is not quantized to roughly 16 bpm steps near a high HR. It only fills seconds the strap never reported; it never overrides a stored HR. 5/MG only, off by default.": {"localizations": {}},"When a fresh, non-exercise HRV dip is detected while you're still, NOOP offers a one-minute guided breath: a single confirming buzz and a dismissible card. Never an alarm, never a diagnosis.": {"localizations": {}},"When on, NOOP taps your wrist for the apps you pick below, so you can leave the %@ and still feel what matters.": {"localizations": {}},"When the %@ apps you choose send a notification, NOOP taps your strap: Slack, Calendar, Messages, whatever matters. Everything stays on %@.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "When the %1$@ apps you choose send a notification, NOOP taps your strap: Slack, Calendar, Messages, whatever matters. Everything stays on %2$@."}}}},"When the ring is reset and waking, tap Scan below.": {"localizations": {}},"When the system prompt appears, choose Allow so NOOP can find your strap.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "When the system prompt appears, choose Allow so NOOP can find your strap."}}}},"When this is on, NOOP rewrites a plain-text file (On My iPhone › NOOP › noop_sync.txt) each time you leave the app: one line per 15 minutes of heart rate, HRV and steps, read straight from your strap. Pair it with the Siri Shortcut that reads the file and logs everything into Apple Health (no HealthKit entitlement needed), so it works on sideloaded installs. The setup guide and the pre-built Shortcut live in the project wiki on GitHub.": {"localizations": {}},"When you import an Apple Health or WHOOP export, iOS hands NOOP a private copy of the file. NOOP reads it, saves your data into the health database, then deletes the copy. Older builds didn't delete every copy. This screen reclaims any that were left behind.": {"localizations": {}},"When your strap is connected NOOP is saving data live. \"Last synced\" tells you how fresh it is. If it says \"Not recording\", reconnect.": {"localizations": {}},"Where NOOP's on-device space is going, and a one-tap clean-up.": {"localizations": {}},"Where a sensor isn't on your watch, NOOP reads “not available” for that metric, never a zero, never an invented number. Everything else keeps working.": {"localizations": {}},"Where your numbers come from": {"localizations": {}},"Which strap are you pairing?": {"localizations": {}},"Which strap?": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Which strap?"}}}},"Which wrist do you wear it on?": {"localizations": {}},"While your strap's battery is low, stop the always-on background HRV stream — the biggest continuous drain on the strap. A Live screen still shows heart rate, and it re-arms automatically once the strap is charged.": {"localizations": {}},"Whole night is NOOP's default measure; Deep sleep pools HRV over slow-wave sleep only, reading lower and matching WHOOP. Switching re-scores your recent nights over the new window and takes effect right away once you have a few nights of data.": {"localizations": {}},"Whoop": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Whoop"}}}},"Whoop import": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Whoop import"}}}},"Why am I run down?": {"localizations": {}},"Why does this grow?": {"localizations": {}},"Why recovery calibrates over about a week": {"localizations": {}},"Why this is logged as a nap": {"localizations": {}},"Why this is your main sleep": {"localizations": {}},"Why this sleep?": {"localizations": {}},"Wind down": {"localizations": {}},"Wind-down nudge": {"localizations": {}},"Window": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Window"}}}},"Windowed rMSSD": {"localizations": {}},"Wire NOOP's actions into a Back-Tap, a focus automation, or a longer Shortcut. For example, double-tap the back of your iPhone to buzz the strap.": {"localizations": {}},"With": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "With"}}}},"Without": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Without"}}}},"Woke": {"localizations": {}},"Won't last the night": {"localizations": {}},"Work": {"localizations": {}},"Working…": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Working…"}}}},"Workout": {"localizations": {}},"Workout file (GPX / TCX / FIT)": {"localizations": {}},"Workout saved": {"localizations": {}},"Workout saved · %@": {"localizations": {}},"Workouts": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Workouts"}}}},"Worn": {"localizations": {}},"Wrist alerts": {"localizations": {}},"Wrist delivery isn't live yet, it needs a small on-device watcher (coming in an update) to read macOS notifications. Everything stays on this Mac. Your choices are saved now and will apply automatically once delivery ships.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Wrist delivery isn't live yet, it needs a small on-device watcher (coming in an update) to read macOS notifications. Everything stays on this Mac. Your choices are saved now and will apply automatically once delivery ships."}}}},"Wrist delivery isn't live yet. It needs a small on-device watcher (coming in an update) to read macOS notifications. Everything stays on this Mac. Your choices are saved now and will apply automatically once delivery ships.": {"localizations": {}},"Wrist temp": {"localizations": {}},"Wrist temperature needs Series 8 or later, and the newest US units dropped the blood-oxygen sensor. Where a sensor isn't there, NOOP reads “not available” instead of zero.": {"localizations": {}},"Writes a timestamped copy of your strap log to NOOP's folder in the Files app, once a day. Handy for a bug report without remembering to grab it. On iPhone it fires when iOS next wakes NOOP near your chosen time, not guaranteed to the minute (keep NOOP open overnight for the best chance). Everything stays on %@; nothing is uploaded.": {"localizations": {}},"Writes a timestamped copy of your strap log to your Documents folder, once a day. Handy for a bug report without remembering to grab it. On Mac it runs while NOOP is open (and catches up on launch if the time passed while it was closed). Everything stays on %@; nothing is uploaded.": {"localizations": {}},"YOUR CARDS": {"localizations": {}},"YOUR DAILY SCORES": {"localizations": {}},"YOUR READING": {"localizations": {}},"Yes": {"localizations": {}},"Yesterday": {"localizations": {}},"Yesterday’s Synthesis": {"localizations": {}},"You can change what you share any time in Settings › Health › Data Access & Devices.": {"localizations": {}},"You can still bring your data in by importing a Health export from Data Sources. A build from the App Store, or one signed with a paid Apple Developer account, connects directly.": {"localizations": {}},"You held the band. Right where today wanted you.": {"localizations": {}},"You removed your active strap. Choose which paired band provides your live data, or leave none active and pair one later.": {"localizations": {}},"You said: %@": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "You said: %@"}}}},"You'll be reminded around %@.": {"localizations": {}},"You'll likely wake around %lld ± %lld Charge if you sleep about %@ tonight.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "You'll likely wake around %1$lld ± %2$lld Charge if you sleep about %3$@ tonight."}}}},"You're all caught up.": {"localizations": {}},"You're carrying about %@ of surplus over %@. You've slept past your need on balance. Nicely ahead.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "You're carrying about %1$@ of surplus over %2$@. You've slept past your need on balance. Nicely ahead."}}}},"You're connected.": {"localizations": {"en": {"stringUnit": {"state": "translated","value": "You're connected."}}}},"You're connected. NOOP is reading your Apple Watch data now. Your Charge score will spend its first week or so calibrating, then settle in.": {"localizations": {}},"You're in a good spot for training.": {"localizations": {}},"You're in balance with your baseline, so moderate strain is well-judged": {"localizations": {}},"You're on the latest (%@).": {"localizations": {}},"You're primed. A hard session should land well today.": {"localizations": {}},"You're roughly on top of your sleep across %@. Slept minutes balance out against your need.": {"localizations": {}},"You're sitting around your typical autonomic baseline: moderate stress, a normal, balanced day.": {"localizations": {}},"You've banked about %@ of sleep debt over %@. Surplus nights count back against it. An earlier night or two would clear it.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "You've banked about %1$@ of sleep debt over %2$@. Surplus nights count back against it. An earlier night or two would clear it."}}}},"You've been seated for about %lld min. Time to move.": {"localizations": {}},"You've hit today's optimal strain target of %lld. Nice work — your recovery earned it.": {"localizations": {}},"Your Apple Watch as a device": {"localizations": {}},"Your Charge (recovery) on the watch face, with Effort and Rest in the rectangular card.": {"localizations": {}},"Your Charge score learns a personal baseline from your heart-rate variability, resting heart rate and more over time. If a bad first week set it off, you can re-learn it from tonight. Your history stays.": {"localizations": {}},"Your Data, Fused": {"localizations": {}},"Your GPS route for this session, recorded and stored on your device. Nothing leaves your phone.": {"localizations": {}},"Your HRV dipped while you were still. Want a minute to breathe?": {"localizations": {}},"Your Monday-to-Sunday, read in one glance.": {"localizations": {}},"WHOOP 5/MG strap alarms require Protocol probes (Test Centre → 5/MG protocol diagnostics). Your wake time is saved, but the strap is not armed yet. Keep a backup alarm.": {"localizations": {}},"Your WHOOP is at 100%.": {"localizations": {}},"Your WHOOP only talks to one phone at a time.": {"localizations": {}},"Your autonomic markers are skewed toward stress today. Treat it as a recovery-focused day.": {"localizations": {}},"Your bands report different numbers. Here's every source, and the one NOOP is using.": {"localizations": {}},"Your bloods, BP and body numbers. Kept private, on %@.": {"localizations": {}},"Your cardiovascular load. NOOP turns every second of heart rate into a training-impulse using heart-rate-reserve zones (Karvonen), weights time in harder zones more heavily (Edwards / Banister), and places it on a logarithmic 0–100 scale, so easy days sit low and an all-out day approaches 100, which stays genuinely rare. A long walk with little cardio still counts, through a steps / active-energy floor.": {"localizations": {}},"Your cards": {"localizations": {}},"Your current strap": {"localizations": {}},"Your curve fills in as the strap offloads its history.": {"localizations": {}},"Your data has been restored. Quit and reopen NOOP for it to take effect.": {"localizations": {}},"Your fluid intake today, on %@ only.": {"localizations": {}},"Your last %lld hours have stayed in the high band. A few minutes of paced breathing can help downshift your nervous system.": {"localizations": {}},"Your last %lld readings: %@ %@, holding steady.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Your last %1$lld readings: %2$@ %3$@, holding steady."}}}},"Your last %lld readings: %@ %@, trending down.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Your last %1$lld readings: %2$@ %3$@, trending down."}}}},"Your last %lld readings: %@ %@, trending up.": {"localizations": {"en": {"stringUnit": {"state": "new","value": "Your last %1$lld readings: %2$@ %3$@, trending up."}}}},"Your live heart rate is working from the strap, and charge, effort and rest build from it over your next few nights of wear, sharpening as it learns your baseline. Want your full history instantly? Import your WHOOP export in Data Sources and it backfills in about a minute.": {"localizations": {}},"Your live heart rate is working from the strap, and recovery, strain and sleep build from it over your next few nights of wear, sharpening as it learns your baseline. Want your full history instantly? Import your WHOOP export in Data Sources and it backfills in about a minute.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Your live heart rate is working from the strap, and recovery, strain and sleep build from it over your next few nights of wear, sharpening as it learns your baseline. Want your full history instantly? Import your WHOOP export in Data Sources and it backfills in about a minute."}}}},"Your locked pace": {"localizations": {}},"Your locked pace · %@ br/min": {"localizations": {}},"Your nervous system is well-recovered, so you're primed to push": {"localizations": {}},"Your numbers, your strap, and how NOOP works. All on %@.": {"localizations": {}},"Your numbers, your strap, and how NOOP works. All on this Mac.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Your numbers, your strap, and how NOOP works. All on this Mac."}}}},"Your profile photo": {"localizations": {}},"Your records never leave %@. There's no account, no cloud, no NOOP server. Because NOOP is an independent app you run yourself (not a healthcare provider), it isn't \"HIPAA-covered,\" and that protection doesn't apply here; the safety comes from the data being local-only and yours.": {"localizations": {}},"Your resonance pace": {"localizations": {}},"Your rhythm looked steady": {"localizations": {}},"Your rhythm varied more than usual": {"localizations": {}},"Your ring": {"localizations": {}},"Your ring talks to NOOP only, fully offline, no Oura account.": {"localizations": {}},"Your scores build over a few nights": {"localizations": {}},"Your signals are aligned and your load is supported. A harder session is well backed today.": {"localizations": {}},"Your strap in real time, heart rate and frames as they arrive.": {"extractionState": "stale","localizations": {"en": {"stringUnit": {"state": "translated","value": "Your strap in real time, heart rate and frames as they arrive."}}}},"Your strap is bonded and ready to stream.": {"localizations": {}},"Your strap is bonded · %lld%% battery.": {"localizations": {}},"Your strap is 